{
  "manifest_version": 3,
  "name": "Telegram Media Saver",
  "version": "0.1.0",
  "description": "Finds media URLs Telegram Web exposes directly and offers ordinary download or copy-to-manager actions.",
  "permissions": [
    "downloads",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://web.telegram.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/a/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Telegram Media Saver",
    "default_popup": "popup.html"
  }
}
